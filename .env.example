# Keep this file private. Never post your tokens or upload .env publicly.
DISCORD_TOKEN=PASTE_YOUR_DISCORD_BOT_TOKEN_HERE
GEMINI_API_KEY=PASTE_YOUR_GEMINI_API_KEY_HERE

# Main chat/reasoning model. Gemini 2.5 Flash uses thinking budgets in this project.
GEMINI_MODEL=gemini-3.8-flash

# Image generation model. Access/availability may depend on your Google AI project.
IMAGE_MODEL=imagen-3.0-generate-002

# Set to the ID of the dedicated chat channel, or leave 0 and use /setchat in Discord.
CHAT_CHANNEL_ID=0

# Your Discord user ID: your app-level daily limit is bypassed for this account only.
# Leave 0 to disable the owner bypass.
OWNER_USER_ID=0

# Other users have this many AI requests per day (image generation also counts).
DAILY_LIMIT=30

# Google Search grounding may incur charges or use quota. Leave false until you check current pricing.
ENABLE_GOOGLE_SEARCH=false
